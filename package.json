{
  "name": "model-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4311 --strictPort",
    "typecheck": "tsc --noEmit",
